generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
  compilerBuild          = "small"
}

datasource db {
  provider = "sqlite"
}

/// A Discord server on which the bot has been initialised with /init setup.
model Guild {
  id        String   @id
  createdAt DateTime @default(now())
}

/// Per-user settings, one row per Discord user.
model User {
  id          String  @id
  lang        String?
  anilist     String?
  myanimelist String?
  mangacollec String?
  /// Whether other users may share the profiles linked above. Only ever true or absent: refusing is the
  /// default, and an absent value lets a row with nothing else in it be deleted.
  allowSharing Boolean?
}
